---
interface Props {
  title: string;
  lg?: number;
  md?: number;
  sm?: number;
}
const { title, lg, md, sm } = Astro.props;
const sizeClasses = [
  lg && `lg-${lg}`,
  md && `md-${md}`,
  sm && `sm-${sm}`,
].filter(Boolean).join(' ');
---

<div class={`${sizeClasses}`}>
  <div class="textbox border">
    <h2 class="bold">{title}</h2>
    <slot />
  </div>
</div>