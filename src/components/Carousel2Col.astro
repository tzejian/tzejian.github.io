---
// src/components/Carousel2Col.astro

// A 2-column carousel that only initializes on Desktop (min-width: 835px).
// On mobile, it natively stacks items in a row.
---

<div class="embla owl2Col" data-inView="slideInUp">
    <div class="embla__viewport">
        <div class="embla__container">
            <slot />
        </div>
    </div>
    <div class="embla__dots"></div>
</div>

<style is:global>
    /* Desktop 2-Column Carousel View */
    @media (min-width: 835px) {
        .owl2Col .embla__container {
            display: flex;
        }
        .owl2Col .embla__container > * {
            /* Auto-width lets Embla size slides based on the image's actual aspect ratio */
            flex: 0 0 auto !important;
            width: auto !important;
            min-width: 0 !important;
            margin-right: 20px !important;
        }
    }
</style>
