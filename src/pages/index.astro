---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectSection from '../components/ProjectSection.astro';
import ProjectIcon from '../components/ProjectIcon.astro';
// import { ClientRouter } from "astro:transitions";
---

<BaseLayout title="Tze Jian's Portfolio | Web Developer & Designer" isHomepage={true}>
	<div class="itemWindow">
  
	  <ProjectSection title="Web Project" lg={12}>
		<div class="imgGroup">
		  <ProjectIcon href="/projects/lmbl" icon="/media/dbs-lmbl-icon.png" label="Project LMBL" />
		  <ProjectIcon href="/projects/ar" icon="/media/dbs-ar-icon.png" label="Project AR" />
		  <ProjectIcon href="/projects/dt" icon="/media/dbs-dt-icon.png" label="Project DT" />
		  <ProjectIcon href="/projects/archives" icon="/media/dbs-archives-icon.png" label="Project Arc" />
		</div>
		<div class="imgGroup">
			<ProjectIcon href="/projects/dsg" icon="/media/dbs-dsg-icon.png" label="Project DSG" />
			<ProjectIcon href="/projects/bc" icon="/media/bc-icon.png" label="Project BC" />
		  <ProjectIcon href="/projects/db" icon="/media/dbs-db-icon.png" label="project DB" />
		  <ProjectIcon href="/projects/fss" icon="/media/fss-icon.png" label="project FSS" />
		</div>
	  </ProjectSection>
  
	  <!-- Design, Hobby, Interactions sections follow same pattern -->
		<ProjectSection title="Design" lg={12}>
			<div class="imgGroup">
				<ProjectIcon href="/design/vietnam-bet" icon="/media/cs-icon.png" label="Research: Vietnam<br> betting sites" />
				<ProjectIcon href="/design/sections" icon="/media/cs-icon.png" label="Research: Sections" />
				<ProjectIcon href="/design/grids" icon="/media/cs-icon.png" label="Research: Grids" />
			</div>
			<div class="imgGroup">
				<ProjectIcon href="/design/neumorphism" icon="/media/cs-icon.png" label="a Neumorphism mockup" />
				<ProjectIcon href="/design/hand-sanitizer" icon="/media/cs-icon.png" label="a hand sanitizer<br>mockup" />
			</div>
		</ProjectSection>

		<ProjectSection title="Hobby Project" lg={12}>
			<div class="imgGroup">
				<ProjectIcon href="/hobby/ve-diving" icon="/media/hp-icon.png" label="Video edit: Diving" />
				<ProjectIcon href="/hobby/tcg" icon="/media/hp-icon.png" label="Card Game Design" />
				<ProjectIcon href="/hobby/koshugi" icon="/media/kcc-icon.png" label="Brand design: Koshugi" />
			</div>
			<div class="imgGroup">
				<ProjectIcon href="/hobby/psd" icon="/media/hp-icon.png" label="Digital Creation" />
				<ProjectIcon href="/hobby/varfont" icon="/media/hp-icon.png" label="Interactions: Variable<br>font effect" />
			</div>
		</ProjectSection>
  
	</div>
</BaseLayout>
