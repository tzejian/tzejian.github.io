---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="a collections of my photoshop creation" windowTitle="web project" showCloseBtn={true}>
  <div class="projectWindow ">
                  
    <div class="lg-6" data-inView="slideIn">
      <div class="textbox">
        <p>Created this poster as i really like the 1980s kind of movie poster which is hand painted. Try to achieve the similar look by recreating in photoshop.</p>
      </div>
    </div>
    <div class="lg-6" data-inView="slideInRight">
      <div class="bitFilter">
        <img  class="lazy" src="../media/small/the_gemini_project_poster.png" data-hiResImg="../media/design/the_gemini_project_poster.webp" alt="">
      </div>
      <h6 class="caption">Experiment to achieve vintage movie poster look</h6>
    </div>
    

    <div class="lg-12" data-inView="slideInUp">
      <div class="owl-carousel owl2Col">
        <div class="eaExpCard">
          <div class="imgWrap bitFilter">
            <img  class="lazy" src="../media/small/sand_dune.png" data-hiResImg="../media/design/sand_dune.webp" alt="">
          </div>
        </div>
        <div class="eaExpCard">
          <div class="imgWrap bitFilter">
            <img  class="lazy" src="../media/small/pc_02.png" data-hiResImg="../media/design/pc_02.webp" alt="">
          </div>
        </div>
        <div class="eaExpCard">
          <div class="imgWrap bitFilter">
            <img  class="lazy" src="../media/small/pc_03.png" data-hiResImg="../media/design/pc_03.webp" alt="">
          </div>
        </div>
        <div class="eaExpCard">
          <div class="imgWrap bitFilter">
            <img  class="lazy" src="../media/small/pc_04.png" data-hiResImg="../media/design/pc_04.webp" alt="">
          </div>
        </div>
    
      </div>
    </div>
    
    <div class="lg-6 lg-offset-3" data-inView="slideIn">
      <div class="textbox">
        <p>This is a collection of digital creations that I've crafted using Procreate. My artistic approach in these pieces revolves around the elegant techniques of ink and wash, inspired by the rich tradition of Chinese painting. Each artwork within this collection embodies the essence of this classical style, offering a unique blend of modern digital artistry with the timeless beauty of Chinese brushwork.</p>
      </div>
    </div>
    
    
  </div>
</BaseLayout>
