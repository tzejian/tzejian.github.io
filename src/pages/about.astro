---

<BaseLayout title="Tze Jian's Portfolio | Web Developer & Designer" isHomepage={false} showCloseBtn={true}>
  <div class="aboutWindow">
    <div class="lg-12" data-inView="slideIn">
      <div class="textbox border">
        <div class="eaGroup">
          <h2 class="bold">Contact</h2>
          <h5>akernus.lr@gmail.com</h5>
          <h5>View my portfolio, <a href="https://tzejian.github.io/" style="display: inline-block;">tzejian.github.io/</a></h5>
          
        </div>
        <div class="eaGroup">
          <h2>Summary</h2>
          <p>I'm  <strong>Tze Jian</strong></p>
          <p>a front-end web developer/ui/ux who enjoys creating intuitive user interfaces and implementing unique micro-interactions. In my free time, I also have a passion for vintage design and products.</p>
          <p>I'm also proficient in using Adobe software like Photoshop, Illustrator, and Premiere Pro to enhance the user experience.</p>
        </div>

      </div>
    </div>
    <div class="lg-12" data-inView="slideIn">
      <div class="textbox border">
        <h2>Skillset</h2>
        <div class="eaGroup">
