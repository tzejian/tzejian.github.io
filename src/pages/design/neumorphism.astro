---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="a Neumorphism mockup" windowTitle="web project" showCloseBtn={true}>
  <div class="projectWindow ">

    <div class="lg-4" data-inView="slideIn">
      <div class="textbox jc">
        <p>I have designed a comprehensive web interface kit using the neumorphism design trend as my inspiration. This kit includes a range of essential design elements such as font scaling, color options, buttons, accordions, card layouts, and section layouts.</p>
      </div>
    </div>
    <div class="lg-8" data-inView="slideInRight">
      <div class="bitFilter">
        <img  class="lazy" src="../media/small/neumorphism-mockup-1.png" data-hiResImg="../media/design/neumorphism-mockup-1.webp" alt="">
      </div>
    </div>
    
    <div class="lg-9" data-inView="slideInRight">
      <div class="bitFilter">
        <img  class="lazy" src="../media/small/neumorphism-mockup-2.png" data-hiResImg="../media/design/neumorphism-mockup-2.webp" alt="">
      </div>
    </div>
    
    <div class="lg-9 lg-offset-3" data-inView="slideInRight">
      <div class="bitFilter">
        <img  class="lazy" src="../media/small/neumorphism-mockup-3.png" data-hiResImg="../media/design/neumorphism-mockup-3.webp" alt="">
      </div>
    </div>
    
    <div class="lg-9" data-inView="slideIn">
      <div class="bitFilter">
        <img  class="lazy" src="../media/design/neumorphism-mockup-4.webp" alt="">
      </div>
      <h6 class="caption">Accordion: A collapsible format for organizing large amounts of information in a compact and organized way</h6>
    </div>
    
    <div class="lg-9 lg-offset-3" data-inView="slideInRight">
      <div class="bitFilter">
        <img  class="lazy" src="../media/design/neumorphism-mockup-5.webp" alt="">
      </div>
      <h6 class="caption">Cards layout: Present information in a visually appealing and organized way using cards to group related content</h6>
    </div>
    
    <div class="lg-9" data-inView="slideIn">
      <div class="bitFilter">
        <img  class="lazy" src="../media/design/neumorphism-mockup-6.webp" alt="">
      </div>
      <h6 class="caption">Section layout: Structure the layout into different sections with a distinct visual style and purpose for an engaging user experience.</h6>
    </div>
    
    
  </div>
</BaseLayout>
