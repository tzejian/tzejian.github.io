---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Research: Vietnam betting sites" windowTitle="web project" showCloseBtn={true}>
  <div class="projectWindow ">

    <div class="lg-7" data-inView="slideIn">
      <div class="textbox jc">
        <p>Tasked with research of current sportsbook competitor as going into Vietnamese market</p>
        
        <p>Analysis focus on competitors platform layouts and choice of fonts for futher localisation</p>
      </div>
    </div>
    <!-- column grid -->
    <div class="lg-12 mOrder_1" data-inView="slideInRight">
      <h3 class="sub">PDF of Case Study</h3>
      <iframe src="../media/case_study_sportsbook.pdf" loading="lazy" frameborder="0" width="100%" height="800px"></iframe>
    </div>

    
    
  </div>
</BaseLayout>
