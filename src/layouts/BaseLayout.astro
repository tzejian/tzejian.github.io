---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import MenuBar from "../components/MenuBar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import NoiseFilter from "../components/NoiseFilter.astro";
interface Props {
  title?: string;
  windowTitle?: string;
  showCloseBtn?: boolean;
  isHomepage?: boolean;
}

const { title = "Tze Jian's Portfolio | Web Developer & Designer", windowTitle = "", showCloseBtn = false, isHomepage = false } = Astro.props;
---

<!doctype html>
<html lang="en"></html>
<head>
  <meta charset="utf-8" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
  <title>{title}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png" />
  <link rel="manifest" href="/favicons/site.webmanifest" />
  <link rel="shortcut icon" href="/favicons/favicon.ico" />
  <meta name="theme-color" content="#ffffff" />
  <script src="../js/main.js"></script>
  <ClientRouter />
</head>
<body>
  <main>
    <div class="backgroundLayer">
      <div class="g">
        <div class="r">
          <div class="lg-12">
            <div class="backgroundWrapper">
              <!-- Header -->
              <Header />

              <div class="content">
                <div class="appWindow" transition:animate="fade">
                  <!-- Menu bar -->
                  <MenuBar windowTitle={windowTitle} showCloseBtn={showCloseBtn} isHomepage={isHomepage} />
                  <!-- Page content slot -->
                  <slot />
                </div>
                <!-- Theme toggle -->
                <ThemeToggle />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
  <!-- SVG noise filter -->
  <NoiseFilter />
</body>

<style lang="scss" is:global>
  @use "/src/styles/global.scss";
</style>
